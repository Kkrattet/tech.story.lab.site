---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import EventCard from "../components/EventCard.astro";
import Kalender from "../components/Kalender.astro";
import Galleri from "../components/Galleri.astro";
import watermarkKalender from "../assets/watermark02.svg";
import watermarkEvents from "../assets/watermark06.svg";
import watermarkInspiration from "../assets/watermark05.svg";

// Billede til hero
import heroBillede from "../assets/image/vr1.jpg";

// Billeder til "Bliv inspireret"
import projektKarma from "../assets/image/podcast1.webp";
import projektKigger from "../assets/image/camera1.webp";
import projektGraenser from "../assets/image/vr1.jpg";
import projektPortraetter from "../assets/image/camera2.webp";
import projektKulisser from "../assets/image/studio7.webp";
import projektSammen from "../assets/image/studies.webp";
import projektLinjer from "../assets/image/podcast2.webp";
import projektOejeblik from "../assets/image/camera4.webp";

const apiurl = "https://pynptdpmxtmlymghsvwv.supabase.co/rest/v1/";
const workshopsTableName = "Workshops";
const options = {
  headers: {
    apikey: "sb_publishable_ufVkQer6tuCPMGxARmZODw_d-_5JubH",
  },
};

interface Workshop {
  id: string;
  name: string;
  date: string;
  description: string;
  image: string;
}

const workshopsResponse = await fetch(
  apiurl + workshopsTableName + "?select=id,name,date,description,image",
  options,
);
const workshopsData = (await workshopsResponse.json()) as Workshop[];

const workshops = workshopsData.map((workshop) => {
  const [dag = "", ...maanedParts] = workshop.date.trim().split(/\s+/);

  return {
    dag: dag.replace(/\.$/, ""),
    maaned: maanedParts.join(" "),
    title: workshop.name,
    tid: workshop.description,
    href: `/Workshops/${encodeURIComponent(workshop.id)}`,
  };
});

const projekter = [
  { title: "Karma", text: "En podcast om livets op- og nedture", image: projektKarma, imageAlt: "Podcastudstyr i studiet" },
  { title: "Hvor kigger vi?", text: "Et eksperiment med øjne og opmærksomhed", image: projektKigger, imageAlt: "Et øje set gennem et kamera" },
  { title: "Uden grænser", text: "En virtuel oplevelse skabt af studerende", image: projektGraenser, imageAlt: "Person med VR-headset i lilla lys" },
  { title: "Portrætter med personlighed", text: "Et fotoprojekt om identitet og udtryk", image: projektPortraetter, imageAlt: "Fotograf med kamera" },
  { title: "Bag kulisserne", text: "Fra den første idé til den færdige film", image: projektKulisser, imageAlt: "Optagelse i fotostudiet" },
  { title: "Skabt sammen", text: "Et kreativt projekt fra idé til virkelighed", image: projektSammen, imageAlt: "Skitser og udstyr på et bord" },
  { title: "Mellem linjerne", text: "En podcast om det, vi sjældent taler om", image: projektLinjer, imageAlt: "Mikrofon og lydmixer" },
  { title: "Et øjeblik i livet", text: "En kortfilm om de små, store øjeblikke", image: projektOejeblik, imageAlt: "Kamera på stativ i et lyst lokale" },
];
---

<BaseLayout title="Events og workshops">
  <Hero
    eyebrow="Events"
    title="Events og workshops"
    subtitle="Kom og nørd med os."
    text="Workshops for nysgerrige, ikke eksperter."
    image={heroBillede}
    imageAlt="Person med VR-headset i lilla lys"
    buttons={[{ label: "Find din workshop", href: "#kalender" }]}
  />

  <div id="events-page-events">
    <Section
      title="Events & workshops"
      subtitle="Workshops for nysgerrige, ikke eksperter."
      buttonText="Se alle events"
      buttonHref="/events"
      baggrund="gradient-wine-pink"
      tekstfarve="pink"
      watermark={watermarkEvents}
    watermarkSide="right"
    watermarkHoejde="517px"
    >
      {workshops.slice(0, 3).map((workshop) => (
        <EventCard {...workshop} farve="pink" />
      ))}
    </Section>
  </div>

  <Kalender  watermark={watermarkKalender}
    watermarkSide="left"
    watermarkHoejde="917px"/>

  <Section
    title="Bliv inspireret"
    subtitle="Se, hvad andre studerende har skabt i labbet."
    baggrund="gradient-off-white"
    tekstfarve="mork"
    kolonner={1}
    watermark={watermarkInspiration}
    watermarkSide="right"
    watermarkHoejde="917px"
  >
    <Galleri
      projekter={projekter}
      buttonText="Døren til inspiration"
      buttonHref="/inspiration"
    />
    
  </Section>
</BaseLayout>

<style>
  :global(#events-page-events .section--pink .section__subtitle) {
    color: var(--color-offwhite-50);
  }
</style>