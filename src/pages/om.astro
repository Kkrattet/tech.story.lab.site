---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import TeamCard from "../components/TeamCard.astro";
import Button from "../components/Button.astro";

// Type til teammedlemmer
type TeamMember = {
  navn: string;
  rolle: string;
  href: string;
  farve: "pink" | "wine";
};

// Teammedlemmer
const team: TeamMember[] = [
  {
    navn: "Frederick Rossling",
    rolle: "LAB-MANAGER",
    href: "#",
    farve: "pink",
  },
  {
    navn: "Luke Frost",
    rolle: "LAB-MANAGER",
    href: "#",
    farve: "pink",
  },
  {
    navn: "Mikki Simonsen",
    rolle: "LAB-MANAGER",
    href: "#",
    farve: "pink",
  },
  {
    navn: "Kristoffer Hyum Nielsen",
    rolle: "LAB-ASSISTENT",
    href: "#",
    farve: "pink",
  },
];
---

<BaseLayout title="Om os">

  <!-- HERO -->
  <Hero
    eyebrow="Om os"
    title="Mød nørderne bag labbet"
    subtitle="Spørg os om alt. Vi elsker det."
    text="Vi er fire nørder med hver vores speciale – fra lyd og podcast til VR og programmering. Kig forbi i A025, så hjælper vi dig i gang med dit projekt."
    buttons={[
      { label: "Spørg os", href: "#find-os" },
    ]}
  />


  <!-- MØD TEAMET -->
  <Section
    title="Mød teamet"
    subtitle="Her er vi. Dit speciale, vores hjælp."
    baggrund="gradient-wine"
    tekstfarve="lys"
    kolonner={1}
  >

    <div class="team-carousel">

  <!-- Pile -->
  <div class="team-controls">
    <a href="#team-1" class="team-control team-control--prev" aria-label="Til første kort">
      ←
    </a>
    <a href="#team-2" class="team-control team-control--next" aria-label="Til næste kort">
      →
    </a>
  </div>

  <!-- Kort -->
  <div class="team-grid">
    {team.map((person, index) => (
      <div class="team-item" id={`team-${index + 1}`}>
        <TeamCard {...person} />
      </div>
    ))}
  </div>

  <!-- Prikker -->
  <div class="team-dots">
    {team.map((person, index) => (
      <a
        href={`#team-${index + 1}`}
        class="team-dot"
        aria-label={`Gå til ${person.navn}`}
      ></a>
    ))}
  </div>

</div>

  </Section>


  <!-- FIND OS -->
  <Section
    title="Find os"
    subtitle="Vi sidder bag receptionen i Guldbergsgade."
    baggrund="gradient-white-pink"
    tekstfarve="mork"
    kolonner={1}
  >

    <div class="find-content" id="find-os">

      <!-- Plads til billede fra Supabase -->
      <div class="find-image">
      </div>

      <!-- Information -->
      <div class="find-info">

        <div class="info-group">
          <h3>Adresse</h3>
          <p>
            EK Guldbergsgade<br />
            Bygning A, lokale A025
          </p>
        </div>

        <div class="info-group">
          <h3>Åbningstider</h3>
          <p>
            Man–tors: 9.00–16.00<br />
            Fre: 9.00–15.00
          </p>
        </div>

        <div class="info-group">
          <h3>Kontakt</h3>
          <p>
            46 46 42 42<br />
            techandstorylab@ek.dk
          </p>
        </div>

        <Button href="mailto:techandstorylab@ek.dk">
          Kontakt os
        </Button>

      </div>

    </div>

  </Section>


  <!-- HVEM ER VI -->
  <Section
    title="Hvem er vi"
    subtitle="Et sted for alle – uanset erfaring."
    baggrund="gradient-wine"
    tekstfarve="lys"
    kolonner={1}
  >

    <div class="about-content">

      <div class="about-text">

        <p>
          Tech & Story Lab er EK's åbne lab for teknologi
          og storytelling.
        </p>

        <p>
          Her kan du udforske, eksperimentere og arbejde
          med lyd, video, VR og meget mere.
        </p>

        <p>
          Vi hjælper dig fra den første idé til det
          færdige projekt. Du behøver ikke være ekspert –
          du skal bare være nysgerrig.
        </p>

        <Button href="/ny-i-labbet">
          Jeg er ny
        </Button>

      </div>

      <!-- Plads til billede fra Supabase -->
      <div class="about-image">
      </div>

    </div>

  </Section>

</BaseLayout>


<style>
/* =====================================
   TEAM – MOBILKARRUSEL
===================================== */

.team-carousel {
  position: relative;
  width: 100%;
  min-width: 0;
}

.team-grid {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  gap: 0 !important;

  width: 100%;
  overflow-x: auto;
  overflow-y: hidden;

  padding-top: 55px;
  padding-bottom: 10px;

  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.team-grid::-webkit-scrollbar {
  display: none;
}

/* Ét slide fylder hele karrusellen */
.team-item {
  flex: 0 0 100% !important;
  width: 100% !important;
  min-width: 100% !important;

  display: flex;
  justify-content: center;

  scroll-snap-align: start;
  scroll-snap-stop: always;
}

/* Selve kortet */
.team-item :global(.team) {
  width: 88%;
  max-width: 350px;
  min-width: 0;
  height: 470px;
  min-height: 430px;
  box-sizing: border-box;
  padding: 24px;
  border-radius: 28px;
}

/* Navn */
.team-item :global(.team__name) {
  max-width: 190px;
  font-size: 1.65rem;
  line-height: 1;
}

/* Rolle */
.team-item :global(.team__role) {
  margin-top: 10px;
  font-size: 0.75rem;
}

/* Pil på kortet */
.team-item :global(.team__arrow) {
  left: 18px;
  bottom: 18px;
  width: 50px;
  height: 50px;
}

/* Navigation øverst til højre */
.team-controls {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 5;

  display: flex;
  gap: 10px;
}

.team-control {
  display: grid;
  place-items: center;

  width: 40px;
  height: 40px;

  border-radius: 50%;
  color: var(--color-black);
  font-size: 22px;
  font-weight: 900;
  text-decoration: none;
}

.team-control--prev {
  background: var(--color-yellow);
  opacity: 0.45;
}

.team-control--next {
  background: var(--color-yellow);
}

/* Prikker */
.team-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin-top: 20px;
}

.team-dot {
  display: block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--color-wine);
  opacity: 0.8;
}

.team-dot:first-child {
  width: 28px;
  border-radius: 20px;
  background: var(--color-yellow);
  opacity: 1;
}

/* FIND OS */

.find-content {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.find-image {
  min-height: 230px;
  overflow: hidden;
  border-radius: 20px;
}

.find-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 22px;

  padding: 26px;
  border-radius: 20px;

  background: var(--color-wine);
  color: var(--color-offwhite-50);
}

.info-group h3 {
  margin: 0 0 8px;
  font-size: 0.95rem;
  font-weight: 900;
  text-transform: uppercase;
}

.info-group p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.6;
}


/* HVEM ER VI */

.about-content {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

.about-text p {
  margin: 0 0 18px;
  font-size: 0.95rem;
  line-height: 1.7;
}

.about-image {
  width: 100%;
  max-width: 450px;
  height: 300px;
  overflow: hidden;
  border-radius: 20px;
}


/* DESKTOP */

@media (min-width: 901px) {

  /* TEAM */

    .team-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px !important;
    overflow: visible;
    padding: 0;
    scroll-snap-type: none;
  }

  .team-item {
    display: block;
    width: auto !important;
    min-width: 0 !important;
  }

  .team-controls,
  .team-dots {
    display: none;
  }

  .team-item :global(.team) {
    width: 100% !important;
    max-width: none !important;
    height: 438px !important;
    min-height: 438px !important;
    padding: 26px;
  }

  .team-item :global(.team__name) {
    font-size: 1.75rem;
  }

  /* FIND OS */
  .find-content {
    grid-template-columns: 1.5fr 1fr;
    gap: 28px;
    align-items: stretch;
  }

  .find-info {
    padding: 32px;
  }


  /* HVEM ER VI */
  .about-content {
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: start;
  }

  .about-image {
    justify-self: center;
    height: 500px;
  }

  .about-text {
    max-width: 500px;
  }

}

</style>