---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CardKarrusel from "../components/CardKarrusel.astro";
import Section from "../components/Section.astro";
import EventCard from "../components/EventCard.astro";
import ImageText from "../components/ImageText.astro";
import NyILabbet from "../components/NyILabbet.astro";
import Galleri from "../components/Galleri.astro";
import watermarkInspiration from "../assets/watermark02.svg";
import watermarkEvents from "../assets/watermark04.svg";
import watermarkTeamet from "../assets/watermark05.svg";
import billedeTeamet from "../assets/image/teamet-gruppe.png";
import logo from "../assets/logo.svg";
import { dev } from "astro";

// Supabase
const apiurl = "https://pynptdpmxtmlymghsvwv.supabase.co/rest/v1/";

const udstyrTableName = "Udstyr";
const teametTableName = "Teamet";
const workshopsTableName = "Workshops";

interface Workshop {
  id: string;
  name: string;
  date: string;
  description: string;
  image: string;
}

const key = "sb_publishable_ufVkQer6tuCPMGxARmZODw_d-_5JubH";

const options = {
  headers: {
    apikey: key,
  },
};

const udstyrResponse = await fetch(apiurl + udstyrTableName, options);
const udstyrData = await udstyrResponse.json();
console.log("udstyrData", udstyrData);

const teametResponse = await fetch(apiurl + teametTableName, options);
const teametData = await teametResponse.json();
console.log("teametData", teametData);

const workshopsResponse = await fetch(
  apiurl + workshopsTableName + "?select=id,name,date,description,image",
  options,
);
const workshopsData = (await workshopsResponse.json()) as Workshop[];
console.log("workshopsData", workshopsData);



// Billeder til "Find vej i labbet"
import kortStudio from "../assets/image/studio1.webp";
import kortUdstyr from "../assets/image/camera1.webp";
import kortBook from "../assets/image/studio5.webp";
import kortNy from "../assets/image/camera3.webp";
import kortProjekter from "../assets/image/podcast3.webp";
import kortEvents from "../assets/image/vr2.webp";
import kortOmOs from "../assets/image/teamet-gruppe.png";

// Billeder til "Bliv inspireret"
import projektKarma from "../assets/image/podcast1.webp";
import projektKigger from "../assets/image/camera1.webp";
import projektGraenser from "../assets/image/vr1.jpg";
import projektPortraetter from "../assets/image/camera2.webp";
import projektKulisser from "../assets/image/studio7.webp";
import projektSammen from "../assets/image/studies.webp";
import projektLinjer from "../assets/image/podcast2.webp";
import projektOejeblik from "../assets/image/camera4.webp";

const findVejKort = [
  {
    title: "Studio",
    text: "Book et studie til podcast, foto og video.",
    href: "/studios",
    image: kortStudio,
    imageAlt: "Fotostudie med lys og kamera",
  },
  {
    title: "Udstyr",
    text: "Kameraer, mikrofoner, VR og meget mere.",
    href: "/udstyr",
    image: kortUdstyr,
    imageAlt: "Kamera holdt op foran et øje",
  },
  {
    title: "Book & lån",
    text: "Lån med dit studiekort. Book på to minutter.",
    href: "/udstyr",
    image: kortBook,
    imageAlt: "Udstyr klar til udlån",
  },
  {
    title: "Ny i labbet?",
    text: "Aldrig prøvet det før? Perfekt.",
    href: "/ny-i-labbet",
    image: kortNy,
    imageAlt: "Studerende arbejder ved en computer i labbet",
  },
  {
    title: "Projekter",
    text: "Se, hvad andre har skabt.",
    href: "/inspiration",
    image: kortProjekter,
    imageAlt: "To studerende optager en podcast",
  },
  {
    title: "Events",
    text: "Workshops, foredrag og fredagsbar.",
    href: "/events",
    image: kortEvents,
    imageAlt: "Person prøver et VR-headset",
  },
  {
    title: "Om os",
    text: "Mød nørderne bag labbet.",
    href: "/om",
    image: kortOmOs,
    imageAlt: "Teamet bag Tech & Story Lab",
    
  },
];

// Projekter til "Bliv inspireret"
// Rækkefølgen bestemmer pladsen i gitteret (1 = stor øverst til venstre)
// Senere kan listen hentes fra Supabase i stedet
const projekter = [
  { title: "Karma", text: "En podcast om livets op- og nedture", image: projektKarma, imageAlt: "Podcastudstyr i studiet" },
  { title: "Hvor kigger vi?", text: "Et eksperiment med øjne og opmærksomhed", image: projektKigger, imageAlt: "Et øje set gennem et kamera" },
  { title: "Uden grænser", text: "En virtuel oplevelse skabt af studerende", image: projektGraenser, imageAlt: "Person med VR-headset i lilla lys" },
  { title: "Portrætter med personlighed", text: "Et fotoprojekt om identitet og udtryk", image: projektPortraetter, imageAlt: "Fotograf med kamera" },
  { title: "Bag kulisserne", text: "Fra den første idé til den færdige film", image: projektKulisser, imageAlt: "Optagelse i fotostudiet" },
  { title: "Skabt sammen", text: "Et kreativt projekt fra idé til virkelighed", image: projektSammen, imageAlt: "Skitser og udstyr på et bord" },
  { title: "Mellem linjerne", text: "En podcast om det, vi sjældent taler om", image: projektLinjer, imageAlt: "Mikrofon og lydmixer" },
  { title: "Et øjeblik i livet", text: "En kortfilm om de små, store øjeblikke", image: projektOejeblik, imageAlt: "Kamera på stativ i et lyst lokale" },
];

const workshops = workshopsData.map((workshop) => {
  const [dag = "", ...maanedParts] = workshop.date.trim().split(/\s+/);

  return {
    dag: dag.replace(/\.$/, ""),
    maaned: maanedParts.join(" "),
    title: workshop.name,
    tid: workshop.description,
    href: `/Workshops/${encodeURIComponent(workshop.id)}`,
  };
});
---

<BaseLayout title="Forside">
  <Hero
    variant="forside"
    eyebrow="EK Guldbergsgade · Lokale A025"
    title="Dit lab til teknologi og storytelling"
    subtitle="Lån udstyr, book et studie og få hjælp til at komme i gang. Gratis for alle på EK."
    image={logo}
    imageAlt="EK Tech & Story Lab"
    buttons={[
      { label: "Book et studie", href: "/studios" },
      { label: "Find udstyr", href: "/udstyr" },
    ]}
    showHours
  />

  <CardKarrusel
    title="Find vej i labbet"
    subtitle="Swipe dig igennem labbet."
    kort={findVejKort}
  />

  <Section
    title="Bliv inspireret"
    subtitle="Se, hvad andre studerende har skabt i labbet."
    baggrund="gradient-off-white"
    tekstfarve="mork"
     kolonner={1}
    watermark={watermarkInspiration}
    watermarkSide="left"
    watermarkHoejde="917px"
  >
    <Galleri
      projekter={projekter}
      buttonText="Døren til inspiration"
      buttonHref="/inspiration"
    />
  </Section>

  <NyILabbet />

  <Section
    title="Events & workshops"
    subtitle="Workshops for nysgerrige, ikke eksperter."
    buttonText="Se alle events"
    buttonHref="/events"
    baggrund="gradient-white-pink"
       tekstfarve="pink"
    watermark={watermarkEvents}
    watermarkSide="left"
    watermarkHoejde="570px"
  >
    {workshops.slice(0, 3).map((workshop) => (
      <EventCard {...workshop} />
    ))}
  </Section>

  <ImageText
    title="Mød nørderne bag labbet"
    subtitle="Spørg os om alt. Vi elsker det."
    text="Vi er fire nørder med hver vores speciale – fra lyd og podcast til VR og programmering. Kig forbi i A025, så hjælper vi dig i gang med dit projekt."
    image={billedeTeamet}
    imageAlt="De fire nørder bag Tech & Story Lab"
    buttonText="Mød teamet"
    buttonHref="/om"
    baggrund="gradient-pink-white"
    tekstfarve="mork"
    watermark={watermarkTeamet}
    watermarkHoejde="712px"
  />
</BaseLayout>