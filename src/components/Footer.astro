---
import logo from "../assets/logo-footer.png";
import illustration from "../assets/watermarkfooter.svg";
---

<footer class="footer">
  <img class="footer__illustration" src={illustration.src} alt="" aria-hidden="true" />

  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <img src={logo.src} alt="EK Tech & Story Lab – til forsiden" width="254" height="132" />
      </a>
      <a href="#" class="footer__newsletter">Tilmeld dig nyhedsbrev →</a>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Find os</h2>
      <p>
        EK Guldbergsgade<br />
        Bygning A, A025<br />
        (bag receptionen)
      </p>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Åbningstider</h2>
      <p>
        Man–tors 9.00–16.00<br />
        Fre 9.00–15.00<br />
        Lukket i juli
      </p>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Genveje</h2>
      <ul>
        <li><a href="#">FAQ</a></li>
        <li><a href="/udstyr">Book & lån</a></li>
        <li><a href="/for-undervisere">For undervisere</a></li>
       <li><a href="/om">Kontakt</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Kontakt</h2>
      <p>
        <a href="tel:+4546460442">46 46 04 42</a><br />
        <a href="mailto:techandstorylab@ek.dk">techandstorylab@ek.dk</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    min-height: 360px;
    padding-block: 54px 84px;
    background: var(--color-bordeaux);
    color: var(--color-offwhite-50);
  }

  /* Vandmærket i højre side */
  .footer__illustration {
    position: absolute;
    top: 12px;
    right: -80px;
    width: 210px;
    height: 378px;
    opacity: 1;
    pointer-events: none;
  }

  .footer__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr repeat(4, 230px);
    gap: 15px;
  }

  /* Logo og knap: boksen bliver lige så bred som logoet */
  .footer__brand {
    display: flex;
    flex-direction: column;
    width: fit-content;
  }

  .footer__logo img {
    display: block;
    width: 254px;
    height: 132px;
    object-fit: contain;
    mix-blend-mode: lighten;
  }

  .footer__newsletter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 56px;
    margin-top: 34px;
    padding-inline: 16px;
    border-radius: 28px;
    background: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.9375rem;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease;
  }

  .footer__newsletter:hover {
    transform: translateY(-2px);
  }

  .footer__heading {
    margin: 0 0 15px;
    color: var(--color-pink);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .footer__col p,
  .footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .footer__col a {
    color: inherit;
    text-decoration: none;
  }

  .footer__col a:hover {
    text-decoration: underline;
  }

  /* Tablet */
  @media (max-width: 1100px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 24px;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  /* Mobil */
  @media (max-width: 600px) {
    .footer {
      padding-block: 40px 60px;
    }

    .footer__illustration {
      width: 140px;
      height: 252px;
      right: -50px;
      opacity: 0.5;
    }

    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 16px;
    }

    .footer__brand {
      margin-inline: auto;
      margin-bottom: 40px;
    }

    .footer__logo img {
      width: 260px;
      height: auto;
    }

    .footer__newsletter {
      margin-top: 40px;
    }

    /* Højre kolonne (Åbningstider og Kontakt) står højrestillet */
    .footer__col:nth-child(odd) {
      text-align: right;
    }
  }
</style>