---
import Button from "./Button.astro";

interface Props {
  dag: string;
  maaned: string;
  title: string;
  tid: string;
  href?: string;
  farve?: "wine" | "pink";
}

const {
  dag,
  maaned,
  title,
  tid,
  href = "#",
  farve = "wine",
} = Astro.props;
---

<article class={`event event--${farve}`}>
  <div class="event__date">
    <span class="event__day">{dag}</span>
    <span class="event__month">{maaned}</span>
  </div>

  <div class="event__body">
    <h3 class="event__title">{title}</h3>
    <p class="event__time">{tid}</p>
    <div class="event__action">
      <Button href={href}>Tilmeld</Button>
    </div>
  </div>
</article>

<style>
  .event {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 24px;
    min-height: 220px;
    padding: 24px;
    border-radius: 28px;
    color: var(--color-offwhite-50);
  }

  .event--wine {
    background: var(--color-wine);
  }

  .event--pink {
    background: var(--color-pink);
  }

  /* Datoboksen til venstre */
  .event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 124px;
    border-radius: 20px;
    background: var(--color-offwhite-50);
    color: var(--color-black);
    font-weight: 900;
    text-transform: uppercase;
  }

  .event__day {
    font-size: 2.75rem;
    line-height: 1;
  }

  .event__month {
    font-size: 1rem;
    line-height: 1.2;
  }

  /* Teksten til højre */
  .event__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 4px;
  }

  /* H4 – 26 Oso Sans, Bold */
  .event__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.625rem;
    font-style: normal;
    font-weight: 700;
    line-height: 1.2;
  }

  /* H5 – 17 Oso Serif, Italic */
  .event__time {
    margin: 12px 0 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.2;
  }

  .event__action {
    margin-top: auto;
  }

  @media (max-width: 600px) {
    .event {
      grid-template-columns: 80px 1fr;
      gap: 16px;
      padding: 20px;
    }

    .event__date {
      height: 100px;
    }

    .event__day {
      font-size: 2.25rem;
    }

    .event__title {
      font-size: 1.375rem;
    }

    .event__action {
      margin-top: 20px;
    }
  }
</style>