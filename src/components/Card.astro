---
interface Props {
  title: string;
  text: string;
  image?: ImageMetadata;
  imageAlt?: string;
  href: string;
  farve?: "pink" | "wine";
  linkLabel?: string;
  status?: string;
}

const {
  title,
  text,
  image,
  imageAlt = "",
  href,
  farve = "pink",
  linkLabel,
  status,
} = Astro.props;
---

<article class={`card card--${farve}`}>
  {image ? (
    <img
      class="card__image"
      src={image.src}
      alt={imageAlt}
      width={image.width}
      height={image.height}
      loading="lazy"
    />
  ) : (
    <div class="card__placeholder" aria-hidden="true">
      
    </div>
  )}

  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    <p class="card__text">{text}</p>

    <div class="card__bottom">
      {status && (
        <span class="card__status">
          <span class="card__dot" aria-hidden="true"></span>
          {status}
        </span>
      )}

      {linkLabel ? (
        <a class="card__link" href={href}>{linkLabel} →</a>
      ) : (
        <a class="card__arrow" href={href} aria-label={`Gå til ${title}`}>→</a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    min-height: 480px;
    padding: 24px;
    border-radius: 28px;
    color: var(--color-offwhite-50);
  }

  .card--pink {
    background: var(--color-pink);
  }

  .card--wine {
    background: var(--color-wine);
  }

  /* Billedet bliver skåret til */
  .card__image {
    width: calc(100% + 72px);
    max-width: none;
    height: 284px;
    object-fit: cover;
    object-position: left center;
  }

  /* Pladsholder med kryds, indtil billedet er sat ind */
  .card__placeholder {
    display: grid;
    place-items: center;
    height: 284px;
    border: 2px dashed rgba(253, 249, 237, 0.6);
    border-radius: 12px;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), rgba(253, 249, 237, 0.6) 50%, transparent calc(50% + 1px)),
      linear-gradient(to bottom right, transparent calc(50% - 1px), rgba(253, 249, 237, 0.6) 50%, transparent calc(50% + 1px));
  }

  .card__placeholder span {
    padding: 4px 12px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.25);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 18px 10px 0;
  }

  /* H4 – 26 Oso Sans, Bold */
  .card__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.625rem;
    font-style: normal;
    font-weight: 700;
    line-height: 1.2;
  }

  /* H5 – 17 Oso Serif, Italic */
  .card__text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.2;
  }

  .card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
  }

  /* Status: ● Ledig nu */
  .card__status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .card__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-magenta);
  }

  /* Lille gul knap: LÅN PAKKEN → / SE LEDIGHED → */
  .card__link {
    padding: 11px 18px;
    border-radius: 22px;
    background: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease;
  }

  /* Rund gul knap med pil */
  .card__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-yellow);
    color: var(--color-black);
    font-size: 1.375rem;
    font-weight: 900;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .card__link:hover,
  .card__arrow:hover {
    transform: translateY(-2px);
  }
</style>