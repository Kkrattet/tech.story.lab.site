---
import { Image } from "astro:assets";

interface Props {
  navn: string;
  rolle: string;
  image?: ImageMetadata;
  href?: string;
  farve?: "pink" | "wine";
}

const {
  navn,
  rolle,
  image,
  href = "#",
  farve = "pink",
} = Astro.props;
---

<article class={`team team--${farve}`}>
  <div class="team__text">
    <h4 class="team__name">{navn}</h4>
    <p class="team__role">{rolle}</p>
  </div>

  {image ? (
    <div class="team-image">
      <Image class="team__photo" src={image} alt={`Portræt af ${navn}`} loading="lazy" />
    </div>
  ) : (
    <div class="team-image team__placeholder" aria-hidden="true">
      <span>Foto</span>
    </div>
  )}

  <a class="team__arrow" href={href} aria-label={`Læs mere om ${navn}`}>→</a>
</article>

<style>
.team {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: 480px;
  height: 480px;
  padding: 24px;
  border-radius: 28px;
  color: var(--color-offwhite-50);
}

  .team--pink {
    background: var(--color-pink);
  }

  .team--wine {
    background: var(--color-wine);
  }

  .team__text {
    position: relative;
    z-index: 1;
  }

  .team__name {
    margin: 0;
    max-width: 280px;
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
  }

  .team__role {
    margin: 10px 0 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .team-image {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 74%;
    height: 74%;
    overflow: hidden;
    clip-path: polygon(
      6% 26%,
      72% 0%,
      100% 6%,
      100% 100%,
      0% 100%
    );
  }

  .team-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .team__placeholder {
    display: grid;
    place-items: center;
    border: 2px dashed rgba(253, 249, 237, 0.6);
    border-radius: 12px;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), rgba(253, 249, 237, 0.6) 50%, transparent calc(50% + 1px)),
      linear-gradient(to bottom right, transparent calc(50% - 1px), rgba(253, 249, 237, 0.6) 50%, transparent calc(50% + 1px));
  }

  .team__placeholder span {
    padding: 4px 12px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.25);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  /* Rund gul pil nederst til venstre */
  .team__arrow {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--color-yellow);
    color: var(--color-black);
    font-size: 1.625rem;
    font-weight: 900;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .team__arrow:hover {
    transform: translateY(-2px);
  }
</style>