---
import Button from "./Button.astro";
import { Image } from "astro:assets";
import baggrund from "../assets/hero-baggrund.png";
import watermark from "../assets/watermarkhero.svg";

interface Props {
  variant?: "forside" | "side";
  eyebrow?: string;
  title: string;
  subtitle?: string;
  text?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  buttons?: { label: string; href: string }[];
  showHours?: boolean;
}

const {
  variant = "side",
  eyebrow,
  title,
  subtitle,
  text,
  image,
  imageAlt = "",
  buttons = [],
  showHours = false,
} = Astro.props;
---

<section class={`hero hero--${variant}`}>
  <Image class="hero__bg" src={baggrund} alt="" aria-hidden="true" loading="eager" />
  <div class="hero__overlay" aria-hidden="true"></div>
  <Image class="hero__watermark" src={watermark} alt="" aria-hidden="true" loading="eager" />

  <div class="container hero__inner">
    {image && (
      <Image class="hero__image" src={image} alt={imageAlt} loading="eager" />
    )}

    <div class="hero__content">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1 class="hero__title">{title}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}
      {text && <p class="hero__text">{text}</p>}

      {buttons.length > 0 && (
        <div class="hero__buttons">
          {buttons.map((button) => (
            <Button href={button.href}>{button.label}</Button>
          ))}
        </div>
      )}

      {showHours && (
        <div class="hero__hours">
          <span class="hero__dot" aria-hidden="true"></span>
          <span class="hero__today">Åbent i dag 9.00–16.00</span>
          <span class="hero__week">Man–tors 9.00–16.00 · Fre 9.00–15.00</span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 816px;
    padding-block: 120px 100px;
    background: var(--color-wine);
  }

  /* Baggrund med farvebølger og mørk overgang i bunden */
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(108, 16, 64, 0) 60%, rgba(108, 16, 64, 0.8));
  }

  /* Watermark i venstre side bag indholdet */
  .hero__watermark {
    position: absolute;
    left: 0;
    bottom: 0;
    width: auto;
    height: 85%;
    pointer-events: none;
  }

  /* Opdeling i to kolonner */
  .hero__inner {
    position: relative;
    display: grid;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  .hero--forside .hero__inner {
    grid-template-columns: minmax(0, 500px) minmax(0, 660px);
  }

  .hero--side .hero__inner {
    grid-template-columns: minmax(0, 640px) minmax(0, 664px);
  }

  /* Billedet: til venstre på forsiden, til højre på undersiderne */
  .hero__image {
    width: 100%;
    height: auto;
  }

  .hero--side .hero__image {
    order: 2;
    aspect-ratio: 1.07 / 1;
    margin-bottom: 30px;
    object-fit: cover;
    object-position: center 20%;
    clip-path: polygon(
      0% 8%,
      62% 0%,
      100% 9%,
      97% 90%,
      54% 100%,
      0% 87%
    );
  }

  .hero--forside .hero__image {
    mix-blend-mode: lighten;
  }

  /* Tekst */
  .hero__eyebrow {
    margin: 0;
    color: var(--color-pink);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero__title {
    margin-top: 14px;
    color: var(--color-offwhite-50);
    line-height: 1;
  }

  .hero--forside .hero__title {
    margin-top: 4px;
  }

  .hero__subtitle {
    margin: 10px 0 0;
    color: var(--color-pink);
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.1;
  }

  .hero--forside .hero__subtitle {
    color: var(--color-offwhite-50);
    font-weight: 300;
  }

  .hero__text {
    margin: 28px 0 0;
    color: var(--color-offwhite-50);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  /* Knapper */
  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 32px;
  }

  /* Åbningstider */
  .hero__hours {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 33px;
    padding: 14px 30px 14px 40px;
    border: 1px solid var(--color-pink);
    border-radius: 30px;
    background: var(--color-bordeaux);
  }

  .hero__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-yellow);
  }

  .hero__today {
    color: var(--color-offwhite-50);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .hero__week {
    color: var(--color-pink);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Mobil og tablet */
  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-block: 48px 64px;
    }

    .hero--forside .hero__inner,
    .hero--side .hero__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero--forside .hero__image {
      max-width: 300px;
      margin-inline: auto;
    }

    .hero__buttons {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .hero__hours {
      padding: 14px 24px;
      border-radius: 24px;
    }

    .hero__watermark {
      height: 50%;
    }
  }
</style>